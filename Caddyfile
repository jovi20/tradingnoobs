{
    # Global options
    email boya.kaede@gmail.com
}

{$DOMAIN:localhost} {
    # Backend API
    handle /api/* {
        reverse_proxy tradingnoobs-backend:8000
    }

    # Frontend App
    handle {
        reverse_proxy tradingnoobs-frontend:3000
    }

    # Compression
    encode gzip zstd

    # Security headers
    header {
        # HSTS (uncomment if you have a valid SSL cert)
        # Strict-Transport-Security "max-age=31536000;"

        # Reduce site fingerprinting
        Server "TradingNoobs/1.0"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    log {
        output stdout
        format json
    }
}
